                </FrameLayout>
                <FrameLayout android:id="@+id/biTabs" android:layout_width="36dp" android:layout_height="46dp" android:background="@drawable/bg_transparent_pressed" android:clickable="true" android:focusable="true" android:contentDescription="Separadores">
                    <TextView android:id="@+id/biTabsCount" android:layout_width="25dp" android:layout_height="25dp" android:layout_gravity="center" android:gravity="center" android:background="@drawable/bg_browser_tab_counter" android:text="1" android:textColor="@color/text" android:textSize="12sp" android:textStyle="bold" />
                </FrameLayout>
                <FrameLayout android:id="@+id/biMore" android:layout_width="36dp" android:layout_height="46dp" android:background="@drawable/bg_transparent_pressed" android:clickable="true" android:focusable="true" android:contentDescription="Menu do navegador">
                    <ImageView android:id="@+id/biMoreIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:scaleType="fitCenter" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/feedPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="end" android:background="@color/bg" android:translationX="1000dp" android:visibility="gone" android:elevation="0dp" android:clipChildren="true" android:clipToPadding="false" android:clickable="true" android:focusable="true">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/feedRecycler" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:overScrollMode="always" android:paddingBottom="10dp" android:scrollbars="none" android:layout_marginTop="104dp" android:layout_marginBottom="128dp" />
        <LinearLayout android:id="@+id/feedEmptyExplore" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="104dp" android:layout_marginBottom="128dp" android:orientation="vertical" android:gravity="center" android:paddingStart="28dp" android:paddingEnd="28dp" android:visibility="gone" android:background="@color/bg">
