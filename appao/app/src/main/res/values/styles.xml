<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compatibility alias used by the v24 resource/theme references. -->
    <style name="AppAo" parent="Theme.AppAo" />
    <style name="Theme" parent="Theme.AppAo" />

    <style name="BubbleUser">
        <item name="android:background">@drawable/bg_bubble_user</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="BubbleAi">
        <item name="android:background">@drawable/bg_bubble_ai</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="DrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_drawer_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>


    <style name="DrawerGridItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">108dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_card_pressed</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>


    <style name="AppAo.ModalWindowAnimations">
        <item name="android:windowEnterAnimation">@anim/modal_slide_in</item>
        <item name="android:windowExitAnimation">@anim/modal_slide_out</item>
    </style>

    <!-- M3 Expressive: anchored popup menus scale/fade in from the anchor corner
         instead of the plain system fade. Used by ThemeOverlay.AppAo.PopupMenu below.
         ".Animation" is the right-anchored (Gravity.END) variant. -->
    <style name="AppAo.PopupMenu.Animation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/popup_scale_in</item>
        <item name="android:windowExitAnimation">@anim/popup_scale_out</item>
    </style>

    <!-- Left-anchored (Gravity.START) variant — the scale pivot must sit on the same side
         the popup actually grows from, or the motion reads as sliding instead of scaling. -->
    <style name="AppAo.PopupMenu.Animation.Start" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/popup_scale_in_start</item>
        <item name="android:windowExitAnimation">@anim/popup_scale_out_start</item>
    </style>

    <!-- M3 Expressive dialog entrance: scale + fade from center instead of a slide. -->
    <style name="AppAo.DialogWindowAnimations">
        <item name="android:windowEnterAnimation">@anim/dialog_scale_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_scale_out</item>
    </style>

    <!-- M3 Expressive active-indicator (pill) for the main BottomNavigationView. The native
         indicator is what slides between items on its own; the color is applied at runtime via
         MainActivity so it always follows the app's current accent color. -->
    <style name="AppAoBottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">52dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/AppAoBottomNavActiveIndicatorShape</item>
    </style>

    <style name="AppAoBottomNavActiveIndicatorShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>