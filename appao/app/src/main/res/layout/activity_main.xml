<?xml version="1.0" encoding="utf-8"?>
<com.appao.DrawerHostLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The whole home surface can be pushed behind the native drawer. -->
    <FrameLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:background="@color/bg">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="142dp"
                android:scrollbars="none" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Native appbar overlay. It moves as a whole, not just its children. -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="@color/bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="4dp">

            <LinearLayout
                android:id="@+id/wPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/wIcon"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/wTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="--°"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hCat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/hCatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/hCatChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/hMore"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/hMoreIcon"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>

        <!-- Bottom AI input remains fixed and translates as a single component. -->
        <LinearLayout
            android:id="@+id/biPill"
            android:layout_width="320dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_card"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:elevation="8dp">

            <FrameLayout
                android:id="@+id/biAdd"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/biAddIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <EditText
                android:id="@+id/biInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/ask_ai"
                android:textColorHint="@color/dim"
                android:textColor="@color/text"
                android:textSize="14.5sp"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <FrameLayout
                android:id="@+id/biSend"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_pri"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/biSendIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Full-height native drawer kept on the RIGHT; it draws edge-to-edge under system bars. -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/bgElevated"
        android:translationX="1000dp"
        android:elevation="22dp"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/drawerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="22dp">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_circle_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/drAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/logo"
                    android:scaleType="centerInside"
                    android:padding="8dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/drName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Convidado"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Inicia sessão para personalizar"
                android:textColor="@color/dim"
                android:textSize="13.5sp"
                android:maxLines="2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/drProfile"
            style="@style/DrawerItem"
            android:minHeight="60dp">

            <ImageView
                android:id="@+id/drIconProfile"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Perfil"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drLibrary"
            style="@style/DrawerItem"
            android:minHeight="60dp">

            <ImageView
                android:id="@+id/drIconLibrary"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Biblioteca"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drSettings"
            style="@style/DrawerItem"
            android:minHeight="60dp">

            <ImageView
                android:id="@+id/drIconSettings"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Definições"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Native progress: its top margin is set from the status-bar inset. -->
    <View
        android:id="@+id/appProgress"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_gravity="top|start"
        android:background="@drawable/progress_gradient"
        android:alpha="0"
        android:elevation="50dp" />

</com.appao.DrawerHostLayout>
