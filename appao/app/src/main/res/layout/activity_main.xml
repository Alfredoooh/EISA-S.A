        </FrameLayout>
        <LinearLayout android:id="@+id/homeContentScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="top" android:layout_marginTop="110dp" android:layout_marginBottom="58dp" android:background="@color/bg" android:clipToPadding="false" android:orientation="vertical">
