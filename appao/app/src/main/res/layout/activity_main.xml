        </LinearLayout>
        <LinearLayout android:id="@+id/homeBottomBar" android:visibility="gone" android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="@color/bg" android:elevation="8dp" android:clipChildren="false" android:clipToPadding="false">
