<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">
    <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg"/>
    <View android:id="@+id/appProgress" android:layout_width="0dp" android:layout_height="3dp" android:layout_gravity="top|start" android:background="@drawable/progress_gradient" android:alpha="0" android:elevation="20dp" android:translationZ="20dp"/>
</FrameLayout>
