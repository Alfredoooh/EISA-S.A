            <LinearLayout android:id="@+id/homeNavHomeTabsGroup" android:layout_width="88dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:orientation="horizontal" android:gravity="center" android:padding="3dp" android:background="@drawable/bg_auth_segment">
