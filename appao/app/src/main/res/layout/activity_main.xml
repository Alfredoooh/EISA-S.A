    <FrameLayout android:id="@+id/appsPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="start" android:background="@color/bg" android:translationX="-1000dp" android:visibility="gone" android:elevation="0dp" android:clipChildren="true" android:clipToPadding="false" android:clickable="true" android:focusable="true">
