                    <GridLayout android:id="@+id/homeQuickSites" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:paddingStart="6dp" android:paddingTop="5dp" android:paddingEnd="6dp" android:paddingBottom="5dp" android:background="@drawable/bg_toolbar_actions" android:columnCount="5" android:alignmentMode="alignMargins" android:useDefaultMargins="false" android:clipChildren="false" android:clipToPadding="false" />
                </FrameLayout>
                <View android:id="@+id/homeQuickDivider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="5dp" android:layout_marginBottom="4dp" android:background="@color/line" android:visibility="gone" />
