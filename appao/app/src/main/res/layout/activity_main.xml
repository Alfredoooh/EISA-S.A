<?xml version="1.0" encoding="utf-8"?>
<com.appao.DrawerHostLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The whole home surface can be pushed behind the native drawer. -->
    <FrameLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:background="@color/bg">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="142dp"
                android:scrollbars="none" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Native appbar overlay. It moves as a whole, not just its children. -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="@color/bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="0dp">

            <FrameLayout
                android:id="@+id/hAdd"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/hAddIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/hCat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/hCatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/hCatChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/hMore"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/hMoreIcon"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>

        <!-- Bottom AI input remains fixed and translates as a single component. -->
        <LinearLayout
            android:id="@+id/biPill"
            android:layout_width="320dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_card"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:elevation="8dp">

            <FrameLayout
                android:id="@+id/biAdd"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/biAddIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <EditText
                android:id="@+id/biInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/ask_ai"
                android:textColorHint="@color/dim"
                android:textColor="@color/text"
                android:textSize="14.5sp"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <FrameLayout
                android:id="@+id/biSend"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_pri"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/biSendIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Indicator stays outside the home container, so the whole home surface
         can move down while the loader remains in the exposed area. -->
    <com.appao.PullRefreshIndicatorView
        android:id="@+id/pullIndicator"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|center_horizontal"
        android:alpha="0"
        android:elevation="30dp" />

    <!-- Reference scrim: follows the horizontal progress without capturing
         touches, dimming the exposed current screen exactly like the HTML. -->
    <View
        android:id="@+id/gestureScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"
        android:elevation="10dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- Empty opposite screen. It enters from the LEFT and pushes the home
         surface to the RIGHT during both edge-swipe and button navigation. -->
    <FrameLayout
        android:id="@+id/sidePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg"
        android:translationX="-1000dp"
        android:elevation="22dp"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="true"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/sideHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="@color/bg"
            android:elevation="0dp">

            <TextView
                android:id="@+id/sideTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Apps"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/sideClose"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/sideCloseIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Full-height native drawer kept on the RIGHT; it draws edge-to-edge under system bars. -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/bgElevated"
        android:translationX="1000dp"
        android:elevation="22dp"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/drawerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <FrameLayout
                android:id="@+id/drBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/drBackIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_card"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/drAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:padding="6dp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/drName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Convidado"
                        android:textColor="@color/text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/drUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Inicia sessão para personalizar"
                        android:textColor="@color/dim"
                        android:textSize="13.5sp"
                        android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout android:id="@+id/drVerify" style="@style/DrawerItem" android:minHeight="58dp">
            <ImageView android:id="@+id/drIconVerify" android:layout_width="28dp" android:layout_height="28dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Verificação" android:textColor="@color/text" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/drSaved" style="@style/DrawerItem" android:minHeight="58dp">
            <ImageView android:id="@+id/drIconSaved" android:layout_width="28dp" android:layout_height="28dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Guardados" android:textColor="@color/text" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/drSettings" style="@style/DrawerItem" android:minHeight="58dp">
            <ImageView android:id="@+id/drIconSettings" android:layout_width="28dp" android:layout_height="28dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Definições" android:textColor="@color/text" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/drFriends" style="@style/DrawerItem" android:minHeight="58dp">
            <ImageView android:id="@+id/drIconFriends" android:layout_width="28dp" android:layout_height="28dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Amigos" android:textColor="@color/text" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/drReport" style="@style/DrawerItem" android:minHeight="58dp">
            <ImageView android:id="@+id/drIconReport" android:layout_width="28dp" android:layout_height="28dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Comunicar um problema" android:textColor="@color/text" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/drAiSettings" style="@style/DrawerItem" android:minHeight="58dp">
            <ImageView android:id="@+id/drIconAi" android:layout_width="28dp" android:layout_height="28dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Configurações de IA" android:textColor="@color/text" android:textSize="15sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Native progress: its top margin is set from the status-bar inset. -->
    <View
        android:id="@+id/appProgress"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_gravity="top|start"
        android:background="@drawable/progress_gradient"
        android:alpha="0"
        android:elevation="50dp" />

</com.appao.DrawerHostLayout>
