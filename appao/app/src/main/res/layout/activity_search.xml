<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/searchContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="80dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/searchTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pesquisa"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/searchQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/dim"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@color/bg"
        android:elevation="0dp">

        <FrameLayout
            android:id="@+id/searchClose"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_transparent_pressed"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/searchCloseIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Pesquisa"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/searchMore"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_transparent_pressed"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/searchMoreIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/searchComposerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:background="@color/bg">

        <LinearLayout
            android:id="@+id/searchComposerPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_pill_card"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:background="@android:color/transparent"
                android:hint="Pergunte, busque ou crie qualquer coisa"
                android:textColorHint="@color/dim"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:includeFontPadding="true"
                android:padding="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/searchAdd"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:id="@+id/searchAddIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:alpha="0.4" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/searchSlider"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="16dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:id="@+id/searchSliderIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:alpha="0.4" />
                    </FrameLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/searchSend"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/searchSendIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
