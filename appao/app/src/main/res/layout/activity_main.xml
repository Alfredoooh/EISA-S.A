<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/wPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/wIcon"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/wTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="--°"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"/>
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <LinearLayout
                android:id="@+id/hCat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="?attr/selectableItemBackgroundBorderless">
                <TextView
                    android:id="@+id/hCatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.03"/>
                <ImageView
                    android:id="@+id/hCatChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:scaleType="fitCenter"/>
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <FrameLayout
                android:id="@+id/hMore"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/hMoreIcon"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"/>
            </FrameLayout>
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="110dp"
                android:overScrollMode="never"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/biPill"
        android:layout_width="320dp"
        android:layout_height="45dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="23dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_blur"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:elevation="12dp">

        <FrameLayout
            android:id="@+id/biAdd"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_card"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/biAddIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"/>
        </FrameLayout>

        <EditText
            android:id="@+id/biInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/ask_ai"
            android:textColorHint="@color/dim"
            android:textColor="@color/text"
            android:textSize="14.5sp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:fontFamily="sans-serif"/>

        <FrameLayout
            android:id="@+id/biSend"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_pri"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/biSendIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"/>
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/catScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#38000000"
        android:alpha="0"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/catSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet_top"
        android:visibility="gone"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/catGrab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">
            <View
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@color/line"/>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="6dp"
            android:paddingBottom="14dp"
            android:text="Categoria"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/catList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>

    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#38000000"
        android:alpha="0"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/bgElevated"
        android:translationX="300dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/drAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_card"
                android:scaleType="centerCrop"
                android:padding="0dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/drName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Convidado"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/drUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inicia sessão para personalizar"
                    android:textColor="@color/dim"
                    android:textSize="12.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/line"/>

        <LinearLayout
            android:id="@+id/drProfile"
            style="@style/DrawerItem">
            <ImageView
                android:id="@+id/drIconProfile"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Perfil"
                android:textColor="@color/text"
                android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drLibrary"
            style="@style/DrawerItem">
            <ImageView
                android:id="@+id/drIconLibrary"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Biblioteca"
                android:textColor="@color/text"
                android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drSettings"
            style="@style/DrawerItem">
            <ImageView
                android:id="@+id/drIconSettings"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Definições"
                android:textColor="@color/text"
                android:textSize="15sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/appProgress"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_gravity="top|start"
        android:background="@drawable/progress_gradient"
        android:alpha="0"
        android:elevation="20dp"/>
</FrameLayout>