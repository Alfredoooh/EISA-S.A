                    <ImageView android:id="@+id/biAddIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:scaleType="fitCenter" />
                </FrameLayout>
                <LinearLayout android:id="@+id/biPill" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="3dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="3dp" android:background="@drawable/bg_toolbar_actions" android:clipChildren="false" android:clipToPadding="false">
