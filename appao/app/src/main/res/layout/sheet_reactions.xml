<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bgElevated"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp" android:paddingBottom="6dp">
        <View android:layout_width="38dp" android:layout_height="4dp"
            android:layout_gravity="center" android:background="@color/line"/>
    </FrameLayout>

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="6dp" android:paddingBottom="14dp"
        android:text="Reagir com"
        android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold"/>

    <LinearLayout
        android:id="@+id/reactGrid"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="8dp" android:paddingEnd="8dp"/>
</LinearLayout>
