<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootArticle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Fixed hero, visually behind the transparent app bar. -->
    <com.appao.RoundedClipFrameLayout
        android:id="@+id/aHeroContainer"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clipToOutline="false"
        android:visibility="gone">
        <ImageView
            android:id="@+id/aHero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_article_hero_gradient" />
    </com.appao.RoundedClipFrameLayout>

    <!-- The sheet itself is the real scroll surface. -->
    <com.appao.BounceScrollView
        android:id="@+id/aScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:overScrollMode="always"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Space
                android:id="@+id/aHeroSpacer"
                android:layout_width="match_parent"
                android:layout_height="280dp" />

            <com.appao.RoundedClipFrameLayout
                android:id="@+id/aSheetCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:clipToOutline="false">

                <LinearLayout
                    android:id="@+id/aSheetInner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="112dp">

                    <LinearLayout
                        android:id="@+id/aSourceRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/aReactSlot"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="8dp"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/aFavicon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_card"
                            android:clipToOutline="true"
                            android:padding="4dp"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/aSource"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/aTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textColor="@color/dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/aTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/text"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.3" />

                    <TextView
                        android:id="@+id/aSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_article_summary"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:textColor="@color/dim"
                        android:textSize="15sp"
                        android:lineSpacingMultiplier="1.6"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/aBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="20dp"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:lineSpacingMultiplier="1.75" />

                    <LinearLayout
                        android:id="@+id/aCommentsSection"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_comments_section"
                        android:clipToOutline="true"
                        android:orientation="vertical"
                        android:paddingBottom="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="20dp"
                            android:paddingTop="20dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="8dp">

                            <ImageView
                                android:id="@+id/cIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Comentários"
                                android:textColor="@color/text"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:textColor="@color/dim"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/cList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.appao.RoundedClipFrameLayout>
        </LinearLayout>
    </com.appao.BounceScrollView>

    <!-- One transparent/solid app bar, matching the HTML behavior. -->
    <LinearLayout
        android:id="@+id/aTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:translationZ="0dp">

        <FrameLayout
            android:id="@+id/aBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_card"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/aBackIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/aMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_card"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/aMoreIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>

    <!-- Existing comment bottom bar is intentionally preserved. -->
    <LinearLayout
        android:id="@+id/articleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="0dp"
        android:translationZ="0dp">

        <LinearLayout
            android:id="@+id/acComposer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_card"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/acInput"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:cursorVisible="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/comentar"
                android:textColorHint="@color/dim"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <FrameLayout
                android:id="@+id/acSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_pri"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/acSendIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/acEmoji"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_transparent_pressed"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/acEmojiIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
