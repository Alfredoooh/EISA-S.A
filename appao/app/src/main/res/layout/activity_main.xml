                <FrameLayout android:id="@+id/homeNavTabs" android:layout_width="40dp" android:layout_height="36dp" android:background="@drawable/bg_auth_indicator" android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/homeNavTabsCount" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:gravity="center" android:background="@drawable/bg_browser_tab_counter" android:text="0" android:textColor="@color/text" android:textSize="12sp" android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <FrameLayout android:id="@+id/homeNavAi" android:layout_width="42dp" android:layout_height="46dp" android:layout_marginStart="4dp" android:background="@drawable/bg_transparent_pressed" android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/homeNavAiIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:id="@+id/homeNavFire" android:layout_width="42dp" android:layout_height="46dp" android:background="@drawable/bg_transparent_pressed" android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/homeNavFireIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:scaleType="fitCenter" />
