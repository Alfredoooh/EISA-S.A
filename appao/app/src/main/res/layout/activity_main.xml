        <FrameLayout android:id="@+id/biBar" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="6dp" android:background="@color/bg" android:clipChildren="false" android:clipToPadding="false" android:paddingStart="4dp" android:paddingTop="4dp" android:paddingEnd="4dp" android:paddingBottom="4dp" android:elevation="0dp">
