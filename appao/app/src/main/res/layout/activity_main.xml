<?xml version="1.0" encoding="utf-8"?>
<com.appao.DrawerHostLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Main surface: intentionally empty apart from navigation and the fixed AI composer. -->
    <FrameLayout
        android:id="@+id/homePage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/homeHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="@color/bg"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/homeMenu"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/homeMenuIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <!-- Feed shortcut: two tilted, overlapping news-image cards. -->
            <FrameLayout
                android:id="@+id/homeFeedStack"
                android:layout_width="82dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/stackBack"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_stack_card"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:rotation="-8" />

                <ImageView
                    android:id="@+id/stackFront"
                    android:layout_width="50dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_stack_card"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:rotation="7" />
            </FrameLayout>
        </FrameLayout>

        <!-- Fixed AI composer. The buttons are bottom-anchored overlays so they do not move
             while the EditText grows upward. -->
        <FrameLayout
            android:id="@+id/biPill"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:minHeight="62dp"
            android:maxHeight="184dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_pill_card"
            android:clipChildren="false"
            android:elevation="8dp">

            <EditText
                android:id="@+id/biInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:layout_marginBottom="5dp"
                android:minHeight="52dp"
                android:maxHeight="118dp"
                android:background="@null"
                android:hint="@string/ask_ai"
                android:textColorHint="@color/dim"
                android:textColor="@color/text"
                android:textSize="14.5sp"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="1"
                android:maxLines="6"
                android:gravity="bottom|start"
                android:scrollbars="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <FrameLayout
                android:id="@+id/biAdd"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_circle_card"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/biAddIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/biSend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_circle_pri"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/biSendIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- News feed replaces the old drawer surface and enters from the right edge. -->
    <FrameLayout
        android:id="@+id/feedPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/bg"
        android:translationX="1000dp"
        android:visibility="gone"
        android:elevation="22dp"
        android:clipChildren="true"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/feedRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="always"
            android:paddingBottom="28dp"
            android:scrollbars="none" />

        <FrameLayout
            android:id="@+id/feedHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="@color/bg"
            android:elevation="4dp">

            <FrameLayout
                android:id="@+id/feedBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/feedBackIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/feedCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/feedCategoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/feedChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/feedPublish"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/feedPublishIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Apps & Conversations enters from the left edge. -->
    <FrameLayout
        android:id="@+id/appsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg"
        android:translationX="-1000dp"
        android:visibility="gone"
        android:elevation="24dp"
        android:clipChildren="true"
        android:clipToPadding="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="@color/bg">

            <FrameLayout
                android:id="@+id/appsProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_circle_card"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/appsProfileAvatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_card"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:id="@+id/appsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Apps e Conversas"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/appsBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/appsBackIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/appsContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="78dp"
            android:background="@color/bg">

            <com.appao.BounceScrollView
                android:id="@+id/appsScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">
                <GridLayout
                    android:id="@+id/appsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="18dp" />
            </com.appao.BounceScrollView>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/conversationsContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="78dp"
            android:background="@color/bg"
            android:visibility="gone">
            <TextView
                android:id="@+id/conversationsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="28dp"
                android:text="As tuas conversas aparecerão aqui."
                android:textColor="@color/dim"
                android:textSize="15sp" />
        </FrameLayout>

        <!-- Bottom floating switcher with a separate settings button. -->
        <FrameLayout
            android:id="@+id/appsBottomTabs"
            android:layout_width="268dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_auth_segment"
            android:padding="4dp"
            android:clipChildren="false">

            <View
                android:id="@+id/appsTabIndicator"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_auth_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/appsTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Apps"
                    android:textColor="@color/onpri"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
                <TextView
                    android:id="@+id/conversationsTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Conversas"
                    android:textColor="@color/dim"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/appsSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_circle_card"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/appsSettingsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </FrameLayout>

    <com.appao.PullRefreshIndicatorView
        android:id="@+id/pullIndicator"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|center_horizontal"
        android:alpha="0"
        android:elevation="30dp" />

    <View
        android:id="@+id/appProgress"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_gravity="top|start"
        android:background="@drawable/progress_gradient"
        android:alpha="0"
        android:elevation="31dp" />
</com.appao.DrawerHostLayout>
