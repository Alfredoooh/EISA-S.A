<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appViewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/browserTopBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/bg"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/browserAddressPill"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="5dp"
            android:background="@drawable/bg_toolbar_actions">
            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp">
                <ImageView
                    android:id="@+id/browserFavicon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside" />
                <com.appao.PullRefreshIndicatorView
                    android:id="@+id/browserFaviconLoader"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
            <EditText
                android:id="@+id/browserAddress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="@android:color/transparent"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:hint="Pesquisar ou inserir endereço"
                android:textColor="@color/text"
                android:textColorHint="@color/dim"
                android:textSize="14sp"
                android:padding="0dp" />
            <FrameLayout
                android:id="@+id/browserAddressClear"
                android:layout_width="30dp"
                android:layout_height="34dp"
                android:visibility="gone"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Limpar pesquisa">
                <ImageView
                    android:id="@+id/browserAddressClearIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/browserTabsTop"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_transparent_pressed"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/browserTabsCountTop"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/bg_browser_tab_counter"
                android:text="1"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/appViewerMore"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_transparent_pressed"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/appViewerMoreIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/browserFindBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/bg"
        android:elevation="8dp"
        android:visibility="gone">
        <EditText
            android:id="@+id/browserFindInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_toolbar_actions"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:hint="Pesquisar nesta página"
            android:textColor="@color/text"
            android:textColorHint="@color/dim"
            android:textSize="15sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
        <FrameLayout
            android:id="@+id/browserFindClose"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_transparent_pressed"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Fechar pesquisa">
            <ImageView
                android:id="@+id/browserFindCloseIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/webSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:elevation="0dp"
            android:background="@color/bg"
            android:transitionName="browser_tab_preview" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</FrameLayout>