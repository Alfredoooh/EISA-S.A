        </com.appao.BounceScrollView>
        <LinearLayout android:id="@+id/feedSavedEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="56dp" android:layout_marginBottom="128dp" android:orientation="vertical" android:gravity="center" android:paddingStart="28dp" android:paddingEnd="28dp" android:visibility="gone" android:background="@color/bg">
