<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material 3 alert dialog theme using only app colors. -->
    <style
        name="Theme.AppAo.Material3Dialog"
        parent="Theme.Material3.DayNight.Dialog.Alert">

        <item name="colorSurface">@color/dialogSurface</item>
        <item name="colorOnSurface">@color/text</item>

        <item name="colorPrimary">@color/pri</item>
        <item name="colorOnPrimary">@color/onpri</item>

        <item name="backgroundTint">@color/dialogSurface</item>

        <item name="colorControlHighlight">
            @android:color/transparent
        </item>

        <item name="android:colorControlHighlight">
            @android:color/transparent
        </item>

        <item name="android:colorControlActivated">
            @color/pri
        </item>

        <item name="shapeAppearanceLargeComponent">
            @style/AppAo.ShapeDialogRounded
        </item>

        <item name="shapeAppearanceMediumComponent">
            @style/AppAo.ShapeDialogRounded
        </item>

        <item name="shapeAppearanceOverlay">
            @style/AppAo.ShapeDialogRounded
        </item>

        <item name="android:windowBackground">
            @android:color/transparent
        </item>

        <item name="android:statusBarColor">
            @android:color/transparent
        </item>

        <item name="android:navigationBarColor">
            @color/dialogSurface
        </item>

        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
