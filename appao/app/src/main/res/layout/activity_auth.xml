<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/authRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/authPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <FrameLayout
            android:id="@+id/authTopBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp">

            <FrameLayout
                android:id="@+id/authClose"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_transparent_pressed"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/authCloseIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </FrameLayout>

        <ScrollView
            android:id="@+id/authScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="26dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="20dp">

                    <ImageView
                        android:id="@+id/authLogo"
                        android:layout_width="180dp"
                        android:layout_height="64dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="app ao"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo" />

                    <TextView
                        android:id="@+id/authSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:maxWidth="330dp"
                        android:text="Entra na tua conta para personalizar o teu app ao"
                        android:textColor="@color/dim"
                        android:textSize="13.5sp"
                        android:lineSpacingMultiplier="1.45" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/authSegmented"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_auth_segment"
                    android:padding="5dp">

                    <View
                        android:id="@+id/authIndicator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_auth_indicator" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/authTabLogin"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Entrar"
                            android:textColor="@color/onpri"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/authTabRegister"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Criar conta"
                            android:textColor="@color/dim"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/authForms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp">

                    <LinearLayout
                        android:id="@+id/loginForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/loginIdType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="6dp"
                            android:paddingBottom="9dp"
                            android:text="EMAIL"
                            android:textColor="@color/dim"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:clickable="true"
                            android:focusable="true" />

                        <EditText
                            android:id="@+id/loginIdentifier"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_auth_input"
                            android:hint="tu@email.com"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:textColor="@color/text"
                            android:textColorHint="@color/dim"
                            android:textSize="15sp"
                            android:singleLine="true"
                            android:inputType="textEmailAddress" />

                        <TextView
                            android:id="@+id/loginPasswordLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:paddingStart="10dp"
                            android:paddingBottom="8dp"
                            android:text="PALAVRA-PASSE"
                            android:textColor="@color/dim"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <EditText
                            android:id="@+id/loginPassword"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_auth_input"
                            android:hint="Mínimo 8 caracteres"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:textColor="@color/text"
                            android:textColorHint="@color/dim"
                            android:textSize="15sp"
                            android:singleLine="true"
                            android:inputType="textPassword" />

                        <TextView
                            android:id="@+id/loginError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="6dp"
                            android:paddingTop="9dp"
                            android:minHeight="24dp"
                            android:textColor="#E5484D"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/loginSubmit"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_auth_primary"
                            android:gravity="center"
                            android:text="Entrar"
                            android:textColor="@color/authYellowText"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/registerForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/registerUsernameLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingBottom="8dp"
                            android:text="NOME DE UTILIZADOR"
                            android:textColor="@color/dim"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <EditText
                            android:id="@+id/registerUsername"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_auth_input"
                            android:hint="teuusername"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:textColor="@color/text"
                            android:textColorHint="@color/dim"
                            android:textSize="15sp"
                            android:singleLine="true"
                            android:inputType="text" />

                        <TextView
                            android:id="@+id/registerIdType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:paddingStart="6dp"
                            android:paddingBottom="9dp"
                            android:text="EMAIL"
                            android:textColor="@color/dim"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:clickable="true"
                            android:focusable="true" />

                        <EditText
                            android:id="@+id/registerIdentifier"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_auth_input"
                            android:hint="tu@email.com"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:textColor="@color/text"
                            android:textColorHint="@color/dim"
                            android:textSize="15sp"
                            android:singleLine="true"
                            android:inputType="textEmailAddress" />

                        <TextView
                            android:id="@+id/registerPasswordLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:paddingStart="10dp"
                            android:paddingBottom="8dp"
                            android:text="PALAVRA-PASSE"
                            android:textColor="@color/dim"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <EditText
                            android:id="@+id/registerPassword"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_auth_input"
                            android:hint="Mínimo 8 caracteres"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:textColor="@color/text"
                            android:textColorHint="@color/dim"
                            android:textSize="15sp"
                            android:singleLine="true"
                            android:inputType="textPassword" />

                        <TextView
                            android:id="@+id/registerError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="6dp"
                            android:paddingTop="9dp"
                            android:minHeight="24dp"
                            android:textColor="#E5484D"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/registerSubmit"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_auth_primary"
                            android:gravity="center"
                            android:text="Criar conta"
                            android:textColor="@color/authYellowText"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/authFootnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Ao continuar, aceitas os termos e a política de privacidade."
                    android:textColor="@color/dim"
                    android:textSize="11.5sp"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
