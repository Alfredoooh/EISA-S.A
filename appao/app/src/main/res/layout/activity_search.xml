<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/searchContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="72dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/searchQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:textColor="@color/dim"
            android:textSize="16sp" />
    </LinearLayout>

    <GridView
        android:id="@+id/searchGalleryGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:numColumns="3"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:padding="6dp"
        android:clipToPadding="false"
        android:stretchMode="columnWidth"
        android:visibility="gone" />

    <TextView
        android:id="@+id/searchMediaEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:text="As imagens do dispositivo aparecerão aqui. Usa o botão da galeria para escolher uma imagem."
        android:textColor="@color/dim"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/searchCameraPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_pressed">
            <TextureView
                android:id="@+id/searchCameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ImageView
                android:id="@+id/searchCameraIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>
        <TextView
            android:id="@+id/searchCameraButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Tirar fotografia"
            android:textColor="@color/onpri"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_circle_pri"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/bg"
        android:elevation="0dp">

        <FrameLayout
            android:id="@+id/searchClose"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_card"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/searchCloseIcon"
                android:layout_width="@dimen/icon_button_icon_size"
                android:layout_height="@dimen/icon_button_icon_size"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/searchModeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/searchMore"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_card"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/searchMoreIcon"
                android:layout_width="@dimen/icon_button_icon_size"
                android:layout_height="@dimen/icon_button_icon_size"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/menuSearchBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:layout_marginTop="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        android:background="@color/bg">

        <LinearLayout
            android:id="@+id/menuSearchPill"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill_card"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <FrameLayout
                android:id="@+id/menuSearchBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/menuSearchBackIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <EditText
                android:id="@+id/menuSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Pesquisar conversas"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/text"
                android:textColorHint="@color/dim"
                android:textSize="15sp" />

            <FrameLayout
                android:id="@+id/menuSearchClear"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:visibility="gone"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/menuSearchClearIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/searchComposerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:background="@color/bg">

        <LinearLayout
            android:id="@+id/searchComposerPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_pill_card"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:background="@android:color/transparent"
                android:hint="Pergunte, busque ou crie qualquer coisa"
                android:textColorHint="@color/dim"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:includeFontPadding="true"
                android:padding="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/searchAdd"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:clickable="true"
                        android:focusable="true" android:background="@drawable/bg_circle_card">
                        <ImageView
                            android:id="@+id/searchAddIcon"
                            android:layout_width="@dimen/icon_button_icon_size"
                            android:layout_height="@dimen/icon_button_icon_size"
                            android:layout_gravity="center"
                            android:alpha="0.6" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/searchSlider"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true" android:background="@drawable/bg_circle_card">
                        <ImageView
                            android:id="@+id/searchSliderIcon"
                            android:layout_width="@dimen/icon_button_icon_size"
                            android:layout_height="@dimen/icon_button_icon_size"
                            android:layout_gravity="center"
                            android:alpha="0.6" />
                    </FrameLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/searchSend"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="@drawable/bg_ai_send"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/searchSendIcon"
                        android:layout_width="@dimen/icon_button_icon_size"
                        android:layout_height="@dimen/icon_button_icon_size"
                        android:layout_gravity="center" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
