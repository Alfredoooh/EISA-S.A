<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appViewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/appViewerToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/bg"
        android:elevation="0dp">

        <FrameLayout
            android:id="@+id/appViewerClose"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_card"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/appViewerCloseIcon"
                android:layout_width="@dimen/icon_button_icon_size"
                android:layout_height="@dimen/icon_button_icon_size"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/appViewerMore"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_card"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/appViewerMoreIcon"
                android:layout_width="@dimen/icon_button_icon_size"
                android:layout_height="@dimen/icon_button_icon_size"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:background="@color/bg" />

    <View
        android:id="@+id/appProgress"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="56dp"
        android:background="@drawable/progress_gradient"
        android:alpha="0"
        android:elevation="20dp"
        android:translationZ="20dp" />
</FrameLayout>
