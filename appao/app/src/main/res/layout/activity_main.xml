                    <FrameLayout android:id="@+id/biSend" android:layout_width="34dp" android:layout_height="38dp" android:background="@drawable/bg_transparent_pressed" android:clickable="true" android:focusable="true" android:contentDescription="Assistente">
                        <ImageView android:id="@+id/biSendIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:scaleType="fitCenter" />
                    </FrameLayout>
                </LinearLayout>
                <FrameLayout android:id="@+id/biFire" android:layout_width="34dp" android:layout_height="46dp" android:background="@drawable/bg_transparent_pressed" android:clickable="true" android:focusable="true" android:contentDescription="Limpar navegação">
