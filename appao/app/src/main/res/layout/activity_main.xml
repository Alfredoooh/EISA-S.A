        <FrameLayout android:id="@+id/homeHeader" android:translationZ="0dp" android:layout_width="match_parent" android:layout_height="110dp" android:layout_gravity="top" android:background="@color/bg" android:clipChildren="false" android:visibility="visible" android:elevation="0dp">
            <TextView android:id="@+id/homeHeaderTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_marginStart="18dp" android:layout_marginTop="7dp" android:text="Início" android:textColor="@color/text" android:textSize="23sp" android:fontFamily="sans-serif-medium" android:importantForAccessibility="yes" />
            <LinearLayout android:id="@+id/homeAddressBar" android:layout_width="match_parent" android:layout_height="44dp" android:layout_gravity="top|center_horizontal" android:layout_marginStart="16dp" android:layout_marginTop="54dp" android:layout_marginEnd="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="6dp" android:background="@drawable/bg_toolbar_actions" android:clipChildren="false" android:clipToPadding="false">
