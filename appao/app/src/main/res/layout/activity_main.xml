<?xml version='1.0' encoding='utf-8'?>
<com.appao.DrawerHostLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rootMain" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:clipChildren="false" android:clipToPadding="false">
