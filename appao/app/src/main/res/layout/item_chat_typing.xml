<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="40dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_circle_gradient"
        android:gravity="center"
        android:text="AI"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_gravity="bottom"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_bubble_ai"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View android:id="@+id/dot1" android:layout_width="7dp" android:layout_height="7dp"
            android:background="@drawable/bg_dot_dim"/>
        <View android:id="@+id/dot2" android:layout_width="7dp" android:layout_height="7dp"
            android:layout_marginStart="4dp" android:background="@drawable/bg_dot_dim"/>
        <View android:id="@+id/dot3" android:layout_width="7dp" android:layout_height="7dp"
            android:layout_marginStart="4dp" android:background="@drawable/bg_dot_dim"/>
    </LinearLayout>
</LinearLayout>
