<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style
        name="Theme.AppAo"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:windowBackground">@color/bg</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item
            name="android:windowLightStatusBar"
            tools:targetApi="m">false</item>

        <item
            name="android:windowLightNavigationBar"
            tools:targetApi="o_mr1">false</item>

        <item name="android:colorAccent">@color/accent</item>

        <item name="colorPrimary">@color/pri</item>
        <item name="colorOnPrimary">@color/onpri</item>
        <item name="colorSecondary">@color/accent</item>

        <item name="colorAccent">@color/accent</item>

        <item
            name="colorControlHighlight">
            @android:color/transparent
        </item>

        <item
            name="android:colorControlHighlight">
            @android:color/transparent
        </item>

        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/dim</item>

        <item name="android:textCursorDrawable">@drawable/cursor_thin</item>

        <!-- Material 3 custom application surfaces. -->
        <item name="bottomSheetDialogTheme">@style/AppAo.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/AppAo.AlertDialog</item>

        <item name="popupMenuStyle">@style/AppAo.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/AppAo.PopupMenu</item>
    </style>

    <style
        name="Theme.AppAo.ImageViewer"
        parent="Theme.AppAo">

        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>

        <item
            name="android:windowLightStatusBar"
            tools:targetApi="m">false</item>

        <item
            name="android:windowLightNavigationBar"
            tools:targetApi="o_mr1">false</item>

        <item name="android:windowSharedElementsUseOverlay">false</item>
    </style>

    <!-- Real Material 3 modal bottom sheet. -->
    <style
        name="AppAo.BottomSheet"
        parent="Theme.Material3.DayNight.BottomSheetDialog">

        <item name="bottomSheetStyle">
            @style/AppAo.BottomSheetModal
        </item>

        <item name="android:windowIsFloating">false</item>

        <item name="android:navigationBarColor">
            @android:color/transparent
        </item>

        <item name="android:statusBarColor">
            @android:color/transparent
        </item>

        <item
            name="android:windowLightStatusBar"
            tools:targetApi="m">false</item>

        <item
            name="android:windowLightNavigationBar"
            tools:targetApi="o_mr1">false</item>

        <item name="colorSurface">@color/dialogSurface</item>
        <item name="colorSurfaceContainer">@color/dialogSurface</item>
        <item name="colorOnSurface">@color/text</item>

        <item name="colorPrimary">@color/pri</item>
        <item name="colorOnPrimary">@color/onpri</item>

        <item name="colorControlHighlight">
            @android:color/transparent
        </item>

        <item name="android:colorControlHighlight">
            @android:color/transparent
        </item>
    </style>

    <style
        name="AppAo.BottomSheetModal"
        parent="Widget.Material3.BottomSheet.Modal">

        <item name="shapeAppearance">
            @style/AppAo.ShapeTopRounded
        </item>

        <item name="shapeAppearanceOverlay">
            @style/AppAo.ShapeTopRounded
        </item>

        <item name="backgroundTint">
            @color/dialogSurface
        </item>

        <item name="android:backgroundTint">
            @color/dialogSurface
        </item>

        <item name="elevation">0dp</item>
    </style>

    <style name="AppAo.ShapeTopRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Standard Material 3 alert dialog, not a bottom sheet. -->
    <style
        name="AppAo.AlertDialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">

        <item name="colorSurface">@color/dialogSurface</item>
        <item name="colorOnSurface">@color/text</item>

        <item name="colorPrimary">@color/pri</item>
        <item name="colorOnPrimary">@color/onpri</item>

        <item name="backgroundTint">@color/dialogSurface</item>

        <item name="shapeAppearanceOverlay">
            @style/AppAo.ShapeDialogRounded
        </item>

        <item name="colorControlHighlight">
            @android:color/transparent
        </item>

        <item name="android:colorControlHighlight">
            @android:color/transparent
        </item>

        <item
            name="android:windowLightStatusBar"
            tools:targetApi="m">false</item>
    </style>

    <style name="AppAo.ShapeDialogRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style
        name="AppAo.PopupMenu"
        parent="Widget.AppCompat.PopupMenu">

        <item name="android:popupBackground">
            @drawable/bg_popup_material
        </item>
    </style>
</resources>
