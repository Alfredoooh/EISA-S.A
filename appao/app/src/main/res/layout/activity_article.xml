<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootArticle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:id="@+id/aScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="110dp">

            <FrameLayout
                android:id="@+id/aHeroContainer"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="0dp"
                android:background="@android:color/transparent"
                android:clipToOutline="false"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/aHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/aTextHero"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_card_pressed"
                android:clipToOutline="true"
                android:padding="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_card"
                            android:clipToOutline="true">

                            <ImageView
                                android:id="@+id/aTextHeroFavicon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="3dp"
                                android:scaleType="centerCrop" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/aTextHeroSource"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/dim"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/aTextHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:ellipsize="end"
                        android:maxLines="4"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.18" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/aReactSlot"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_circle_card"
                    android:clipToOutline="true">
                    <ImageView
                        android:id="@+id/aFavicon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="2dp"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <TextView
                    android:id="@+id/aSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/aTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/text"
                android:textSize="25sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/aSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_card"
                android:padding="14dp"
                android:textColor="@color/dim"
                android:textSize="14.5sp"
                android:lineSpacingMultiplier="1.6"
                android:visibility="gone" />

            <TextView
                android:id="@+id/aBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.72" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_comments_section"
                android:clipToOutline="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/cIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Comentários"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/dim"
                        android:textSize="16sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/cList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/aTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="10dp"
        android:background="@color/bg"
        android:elevation="8dp">

        <FrameLayout
            android:id="@+id/aBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/bg_news_row"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/aBackIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/aTopTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Notícia"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/aCopy"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_news_row"
            android:clickable="true">
            <ImageView
                android:id="@+id/aCopyIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/aSave"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_news_row"
            android:clickable="true">
            <ImageView
                android:id="@+id/aSaveIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/aShare"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_news_row"
            android:clickable="true">
            <ImageView
                android:id="@+id/aShareIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/articleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bgElevated"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/acComposer"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_card"
            android:paddingStart="18dp"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/acInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/comentar"
                android:textColorHint="@color/dim"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <FrameLayout
                android:id="@+id/acSend"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_pri"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/acSendIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/acEmoji"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_news_row"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/acEmojiIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
